{
  "name": "medecine-esthetique-liege",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "_commentaire": "L'ORDRE DES ÉTAPES EST UN INVARIANT (adsim-core, GUIDE § 6.4). verify est bloquant : si l'audit échoue, rien n'est mis en ligne. Le typecheck n'est pas dans la chaîne tant que les erreurs héritées ne sont pas corrigées.",
    "build": "npm run test && npm run sync && npm run images && npm run build:ssr && npm run build:client && npm run prerender && npm run entetes && npm run verify",
    "sync": "node scripts/sync.mjs",
    "images": "node scripts/images.mjs",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-server",
    "build:client": "vite build",
    "prerender": "node scripts/prerender.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "dev": "vite",
    "lint": "eslint .",
    "preview": "node scripts/servir.mjs",
    "entetes": "node scripts/generer-entetes.mjs",
    "verify": "node audit.mjs --racine . --json rapports/seo.json"
  },
  "dependencies": {
    "@adsim/primitives": "link:../adsim-core/packages/primitives",
    "@adsim/seo-audit": "link:../adsim-core/packages/seo-audit",
    "@adsim/seo-core": "link:../adsim-core/packages/seo-core",
    "@adsim/sitemap": "link:../adsim-core/packages/sitemap",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@supabase/supabase-js": "^2.57.4",
    "@types/react-calendar": "^3.9.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-calendar": "^6.0.0",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
